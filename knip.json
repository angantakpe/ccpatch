{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "bin/extract-from-binary.mjs",
    "bin/repack-bundle.mjs",
    "bin/scaffold-patch.mjs",
    "scripts/codemod-declarative.mjs",
    "scripts/print-banner.mjs",
    "scripts/anchor-report.mjs",
    "scripts/verify-bundle-sha.mjs",
    "runner/cli.mjs",
    "tools/ccpatch-bridge.mjs",
    "tools/anchor-doctor.mjs",
    "tools/bench-align.mjs",
    "tools/build-refmap.mjs",
    "tools/repl.mjs",
    "tools/repl-child.mjs",
    "tools/tweakcc-anchors.mjs",
    "tests/**/*.test.mjs",
    "tests/smoke_bridge.mjs",
    "tests/bridge_host.mjs",
    "tests/smoke_integration.mjs",
    "core/**/*.mjs",
    "extensions/**/*.mjs"
  ],
  "project": [
    "core/**/*.mjs",
    "extensions/**/*.mjs",
    "runner/**/*.mjs",
    "tools/**/*.mjs",
    "tests/**/*.mjs",
    "bin/**/*.mjs",
    "scripts/**/*.mjs"
  ],
  "ignore": [
    "tools/reconstructor/**",
    "**/fixtures/**",
    "runner/agents-dir-builder.mjs"
  ],
  "ignoreDependencies": [
    "ink",
    "react",
    "source-map",
    "concurrently"
  ],
  "ignoreBinaries": [
    "concurrently"
  ],
  "tags": [
    "-knipignore"
  ],
  "ignoreExportsUsedInFile": true
}
