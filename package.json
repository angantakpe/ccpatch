{
  "name": "@codehornets/ccpatch",
  "version": "0.3.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "A patch framework for the official Anthropic Claude Code CLI — extract, unminify, and apply JavaScript-level patches to add features, fix bugs, and expose internals.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "cli",
    "patch",
    "bundle",
    "unminify"
  ],
  "license": "MIT",
  "author": "Anga Ntakpe <codehornets@gmail.com>",
  "bin": {
    "ccpatch": "bin/patch-cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angantakpe/ccpatch.git"
  },
  "bugs": {
    "url": "https://github.com/angantakpe/ccpatch/issues"
  },
  "homepage": "https://github.com/angantakpe/ccpatch#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "runner/",
    "core/",
    "extensions/",
    "tools/",
    "types/",
    "refmaps/",
    "ccpatch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "SUPPORTED_VERSIONS.md",
    "CONTRIBUTING.md"
  ],
  "workspaces": ["tools/reconstructor", "packages/adk"],
  "scripts": {
    "test:patches": "node --test tests/patch-verification.test.mjs",
    "test:patch": "node -e \"const n=process.env.CCPATCH_TEST_PATCH;if(!n){console.error('test:patch: set CCPATCH_TEST_PATCH=<patch> (e.g. CCPATCH_TEST_PATCH=debug npm run test:patch)');process.exit(2)}const{spawnSync}=require('child_process');process.exit(spawnSync(process.execPath,['--test','--test-name-pattern','^'+n+'$','tests/patch-verification.test.mjs'],{stdio:'inherit'}).status||0)\"",
    "test:boot": "node --test tests/boot-smoke.test.mjs tests/boot-tty.test.mjs",
    "test:tty": "node --test tests/boot-tty.test.mjs",
    "test:integration": "node tests/integration_roundtrip.mjs",
    "test:adk": "node --test packages/adk/tests/*.test.mjs",
    "test:all": "node --test tests/*.test.mjs packages/adk/tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs packages/adk/tests/*.test.mjs",
    "test:watch": "node --watch --test tests/*.test.mjs packages/adk/tests/*.test.mjs",
    "lint:dead": "node scripts/lint-dead.mjs",
    "lint:unused": "knip",
    "lint:unused:fix": "knip --fix",
    "lint:unused:prod": "knip --production --strict",
    "lint:types": "node scripts/gen-types.mjs && tsc --noEmit --strict types/patch.d.ts",
    "lint:declarative": "node scripts/check-declarative.mjs",
    "lint:anchors": "node scripts/lint-anchors.mjs",
    "lint:profiles": "node scripts/lint-profiles.mjs",
    "lint": "concurrently --group --kill-others-on-fail 'npm:lint:dead' 'npm:lint:unused' 'npm:lint:types' 'npm:lint:declarative' 'npm:lint:anchors' 'npm:lint:profiles'",
    "gen:types": "node scripts/gen-types.mjs",
    "tui": "node bin/patch-tui.mjs"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "diff": "^9.0.0",
    "js-yaml": "^4.1.1"
  },
  "optionalDependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.0.0",
    "knip": "^5.39.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  }
}
