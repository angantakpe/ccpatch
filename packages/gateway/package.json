{
  "name": "@codehornets/ccpatch-gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "External messaging-channel gateway for a ccpatch-patched Claude Code CLI — bridges Telegram (and other channels) to a live session over the headless_bridge NDJSON socket.",
  "main": "run.mjs",
  "bin": {
    "ccpatch-gateway": "run.mjs"
  },
  "exports": {
    ".": "./bridge-client.mjs",
    "./bridge-client": "./bridge-client.mjs",
    "./adapter": "./adapter.mjs",
    "./adapters/telegram": "./adapters/telegram.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Anga Ntakpe <codehornets@gmail.com>",
  "files": [
    "run.mjs",
    "bridge-client.mjs",
    "adapter.mjs",
    "config.mjs",
    "adapters/telegram.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node run.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "optionalDependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
